# Copy to .env and fill in real values. Never commit .env itself.

# --- Postgres ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sjused
DB_PASSWORD=
DB_PORT=5432

# --- Server ---
# Optional, defaults to 3000 (server.js:12)
PORT=3000
# Used to sign the session cookie. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- URLs ---
# Where the React app is served. Used for the post-OAuth redirect.
FRONTEND_URL=http://localhost:5173
# Where this API is served. Used to build the Google OAuth callback URL.
BACKEND_URL=http://localhost:3000

# --- Google OAuth ---
# From https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: <BACKEND_URL>/api/auth/google/callback
CLIENTID=
CLIENTSECRET=
